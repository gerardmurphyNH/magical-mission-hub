# Copy to .env and fill in for local dev. On Netlify, set these under
# Site configuration -> Environment variables (not in this file, not in git).

# --- Client (bundled into the browser build; the anon key is safe to expose —
#     security is enforced by Supabase Row Level Security) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Server only (Netlify Functions; NEVER exposed to the browser) ---
# Service role key bypasses RLS entirely — Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Settings -> API Keys -> Create API Key (Sending access is enough).
RESEND_API_KEY=
# Any long random string, e.g. `openssl rand -hex 32` — signs the one-click
# approve/reject links so they need no login. Changing it invalidates any
# moderation emails already sent but not yet clicked.
MODERATION_SECRET=
# Where new-letter moderation emails are sent.
MODERATOR_EMAIL=gerard@wigglytoothworkshop.com
# Must be on a domain verified in Resend (Domains -> Add Domain -> DNS records).
EMAIL_FROM=Wiggly Tooth Workshop <letters@wigglytoothworkshop.com>
SITE_URL=https://wigglytoothworkshop.com
